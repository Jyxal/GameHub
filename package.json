{
  "name": "gamehub-desktop",
  "productName": "GameHub",
  "version": "0.1.0-beta.2",
  "private": true,
  "description": "A local-first Windows gaming hub.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "node scripts/package-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "systeminformation": "^5.33.26"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.jyxal.gamehub",
    "productName": "GameHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GameHub-${version}-Windows-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GameHub",
      "uninstallDisplayName": "GameHub"
    },
    "artifactName": "GameHub-${version}-Windows-x64-Setup.${ext}",
    "asar": true
  }
}
