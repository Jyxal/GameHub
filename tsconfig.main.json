{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts", "electron.vite.config.ts"]
}
